# Mapbox (public — safe to expose to browser)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Supabase (public anon key — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API (no trailing slash; https is required outside localhost)
# Production / Vercel: https://api.177-202-246-251.nip.io (Caddy + Let's Encrypt on the VPS)
# The client sanitizes this value (trims whitespace/quotes/trailing slash,
# rejects the decommissioned Render hosts prehub-backend.onrender.com and
# peta-nadi.onrender.com) and falls back to the same VPS URL on non-localhost
# hosts. NEXT_PUBLIC_WS_URL follows the same host over wss.
NEXT_PUBLIC_API_URL=https://api.177-202-246-251.nip.io
NEXT_PUBLIC_WS_URL=wss://api.177-202-246-251.nip.io
