# Mapbox (public — safe to expose to browser)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Supabase (public anon key — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API (no trailing slash; https is required outside localhost)
# Production / Vercel: https://peta-nadi.onrender.com
# The client sanitizes this value (trims whitespace/quotes/trailing slash,
# rejects the decommissioned prehub-backend.onrender.com) and falls back to
# https://peta-nadi.onrender.com on non-localhost hosts.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
