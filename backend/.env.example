# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (Upstash or local Memurai)
REDIS_URL=rediss://your-upstash-endpoint:6379
REDIS_PASSWORD=your-redis-password

# AI Models
GEMINI_API_KEY=your-gemini-api-key
# LTM embedding model (Phase 59 batch C): gemini-embedding-001 truncated to
# 768 dims in code to hold the vector(768) column contract. Changing model OR
# dims requires a migration + full re-embed (one-way distribution shift).
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# (see agents/memory/ltm.py; no chat model env var — chat is opencode/NIM)
DEEPSEEK_API_KEY=your-deepseek-api-key

# opencode-go Swarm LLM (Phase 58: mimo reasoning + deepseek driver)
OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_REASONING_MODEL=mimo-v2.6-pro
OPENCODE_DRIVER_MODEL=deepseek-v4.1-flash

# NVIDIA NIM Keys
NVIDIA_DEEPSEEK_V4_PRO=your-nvidia-deepseek-pro-key
NVIDIA_DEEPSEEK_V4_FLASH=your-nvidia-deepseek-flash-key

# External APIs
TOMTOM_API_KEY=WTTzRq2Ta8ePqH5OAjOz5mSL10TaAywr
AISSTREAM_API_KEY=07caf41281cc2f2ac75591927858dbe6794a27ea

# WhatsApp (Phase 5)
WHATSAPP_TOKEN=your-whatsapp-business-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_RECIPIENT_NUMBER=your-test-whatsapp-number
APP_URL=http://localhost:3000

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
