# ==============================================================================
# PetaNadi / LRIP — Environment Variables
# Copy this to .env and fill in your actual credentials.
# NEVER commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (https://supabase.com)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# Redis — Upstash recommended (https://upstash.com → create Redis database)
# Copy the "UPSTASH_REDIS_REST_URL" and use as REDIS_URL with rediss:// scheme
# ------------------------------------------------------------------------------
REDIS_URL=rediss://your-upstash-endpoint:6379
REDIS_PASSWORD=your-upstash-password

# ------------------------------------------------------------------------------
# AI Models
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# ------------------------------------------------------------------------------
# External Data APIs
# BMKG and NASA FIRMS are FREE public APIs — no key required
# ------------------------------------------------------------------------------
TOMTOM_API_KEY=WTTzRq2Ta8ePqH5OAjOz5mSL10TaAywr
AISSTREAM_API_KEY=07caf41281cc2f2ac75591927858dbe6794a27ea

# Optional (for alert notifications)
WHATSAPP_TOKEN=your-whatsapp-business-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_RECIPIENT_NUMBER=your-test-whatsapp-number
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend — exposed to browser (NEXT_PUBLIC_ prefix required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoicWhhbmFraW56aGF2aSIsImEiOiJjbXI4cG8zN2wxazE5MnhweGwweHY0d2F2In0.rdp0gPLafjh-8X3IZttVog
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# App settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
