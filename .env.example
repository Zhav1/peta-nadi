# ==============================================================================
# PetaNadi / LRIP — Environment Variables
# Copy this to .env and fill in your actual credentials.
# NEVER commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (https://supabase.com)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# Redis — Upstash recommended (https://upstash.com → create Redis database)
# Copy the "UPSTASH_REDIS_REST_URL" and use as REDIS_URL with rediss:// scheme
# ------------------------------------------------------------------------------
REDIS_URL=rediss://your-upstash-endpoint:6379
REDIS_PASSWORD=your-upstash-password

# ------------------------------------------------------------------------------
# AI Models
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# LTM embedding model (Phase 59 batch C): gemini-embedding-001 truncated to
# 768 dims in code to hold the vector(768) column contract. Changing model OR
# dims requires a migration + full re-embed (one-way distribution shift).
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# (no chat model env var for Gemini — chat is Mistral primary + opencode fallback)
DEEPSEEK_API_KEY=your-deepseek-api-key

# ------------------------------------------------------------------------------
# Mistral — PRIMARY chat provider (OpenAI-compatible https://api.mistral.ai/v1)
# MISTRAL_API_KEY is a paid-subscription secret — dashboard-only, never commit real value
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=your-mistral-api-key
# Mistral catalog serves the 1017 snapshot of DeepSeek V4.1 Flash.
MISTRAL_MODEL=deepseek-v4-1-flash-1017

# ------------------------------------------------------------------------------
# opencode-go Swarm LLM (FALLBACK after Mistral: mimo reasoning + deepseek driver)
# OPENCODE_API_KEY is paid-subscription secret — dashboard-only, never commit real value
# ------------------------------------------------------------------------------
OPENCODE_API_KEY=your-opencode-api-key
# Go subscription model IDs (https://opencode.ai/docs/go). mimo-v2.6-flash-free
# is an IDE-only model that 403s on third-party /chat/completions calls.
# Reasoning default is mimo-v2.6-pro (Go plan, $0.435/$0.87 per 1M).
OPENCODE_REASONING_MODEL=mimo-v2.6-pro
OPENCODE_DRIVER_MODEL=deepseek-v4.1-flash
# Reasoning effort calibration ('low', 'medium', 'high') to throttle excessive internal CoT tokens
OPENCODE_REASONING_EFFORT=low

# ------------------------------------------------------------------------------
# External Data APIs
# BMKG is a FREE public API — no key required.
# NASA FIRMS requires a free MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/):
#   - Render: set NASA_FIRMS_MAP_KEY as env var (dashboard-only, sync:false — see render.yaml)
#   - Local:  put NASA_FIRMS_MAP_KEY=... in .env.local (never commit; .gitignore covers .env*)
# Without the key the backend stays honest-degraded (gray Karhutla toggle, 'butuh MAP_KEY').
# ------------------------------------------------------------------------------
TOMTOM_API_KEY=your_tomtom_api_key_here
TOMTOM_API_KEY_2=your-second-tomtom-key
AISSTREAM_API_KEY=your_aisstream_api_key_here
NASA_FIRMS_MAP_KEY=your-nasa-firms-map-key
# Optional
LIGHTPANDA_URL=
TWITTER_BEARER_TOKEN=

# Optional (for alert notifications)
WHATSAPP_TOKEN=your-whatsapp-business-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_RECIPIENT_NUMBER=your-test-whatsapp-number
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend — exposed to browser (NEXT_PUBLIC_ prefix required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# App settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
PREHUB_DB_PATH=/app/data/prehub_local.db

# ------------------------------------------------------------------------------
# Demo Settings
# Set both to true to run fully offline without live APIs or databases
# ------------------------------------------------------------------------------
DEMO_MOCK_AGENTS=false
DEMO_OFFLINE=false

# ------------------------------------------------------------------------------
# Production (VPS) — thin-web contract, see docs/VPS_DEPLOY.md
# The web process runs ONE uvicorn worker (compose command enforces --workers 1)
# and batch ingestion is driven externally by POST /internal/tick every 5 min
# (compose `scheduler` sidecar). Overriding the three booleans in dev is what
# keeps the in-process pollers; do not flip them on the VPS.
# ------------------------------------------------------------------------------
INPROCESS_BATCH_POLLERS=false
POLLERS_ENABLED=true
# Shared secret for POST /internal/tick (X-Internal-Token header). An EMPTY
# value disables the endpoint entirely (404s). Generate: openssl rand -hex 32.
INTERNAL_TICK_TOKEN=change-me-openssl-rand-hex-32
# GHCR backend image consumed on the VPS by `docker compose pull`, e.g.
# IMAGE=ghcr.io/<owner>/<repo>/backend   (tag set per-deploy via IMAGE_TAG)
IMAGE=prehub-backend
IMAGE_TAG=latest
# Reverse proxy host for Caddy automatic TLS (api.<DOMAIN>)
API_DOMAIN=api.example.com
